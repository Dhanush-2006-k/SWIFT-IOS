var name="DHANUSH"
var marks=[40,50,60,70,80]
var tot=0
for mark in marks{
  tot+=mark
}
let avg=Double(tot)/Double(marks.count)
print("name: \(name)")
print("Marks:\(tot)")
print("avg: \(avg)")
if avg>50{
  print("RESULT:\("Pass")")
}else{
  print("RESULT:\("Fail")")
}


